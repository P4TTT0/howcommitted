# GitHub personal access token used server-side for the GraphQL API. Previews use a separate token.
# GITHUB_TOKEN=

# Upstash Redis REST endpoint for the cache. Previews use a separate database or key prefix.
# UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token. Previews use a separate value.
# UPSTASH_REDIS_REST_TOKEN=
