# Required. GitHub personal access token used server-side for the GraphQL API. Previews use a separate token.
# GITHUB_TOKEN=

# Required. Upstash Redis REST endpoint for the cache. Previews use a separate database or key prefix.
# UPSTASH_REDIS_REST_URL=

# Required. Upstash Redis REST token. Previews use a separate value.
# UPSTASH_REDIS_REST_TOKEN=

# Required for /api/history. Signs the anonymous visitor cookie (at least 32 characters). Generate with: openssl rand -base64 32
# QUOTA_COOKIE_SECRET=

# Optional. Namespace prepended to every cache and rate limit key. Set it on previews (for example "preview") so they never share keys with production.
# CACHE_KEY_PREFIX=
